const esbuild = require("esbuild");
const path = require("path");

// Bundle counter domain for webview (browser-compatible)
esbuild.build({
  entryPoints: [path.join(__dirname, "src/counter/counter.ts")],
  bundle: true,
  outfile: path.join(__dirname, "out/counter/view/counter_bundle.js"),
  format: "iife",
  globalName: "CounterDomain",
  platform: "browser",
  target: "es2020",
  sourcemap: true,
}).then(() => {
  console.log("counter_bundle.js built successfully");
}).catch((err) => {
  console.error("Build failed:", err);
  process.exit(1);
});

// Bundle counter_client for webview
esbuild.build({
  entryPoints: [path.join(__dirname, "src/counter/view/counter_client.ts")],
  bundle: true,
  outfile: path.join(__dirname, "out/counter/view/counter_client.js"),
  format: "iife",
  platform: "browser",
  target: "es2020",
  sourcemap: true,
  external: ["../counter"], // Use counter_bundle.js separately
}).then(() => {
  console.log("counter_client.js built successfully");
}).catch((err) => {
  console.error("Build failed:", err);
  process.exit(1);
});

// Bundle engine_client for webview
esbuild.build({
  entryPoints: [path.join(__dirname, "src/engine/view/engine_client.ts")],
  bundle: true,
  outfile: path.join(__dirname, "out/engine/view/engine_client.js"),
  format: "iife",
  platform: "browser",
  target: "es2020",
  sourcemap: true,
}).then(() => {
  console.log("engine_client.js built successfully");
}).catch((err) => {
  console.error("Build failed:", err);
  process.exit(1);
});
