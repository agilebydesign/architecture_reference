{
  "name": "agilebot-counter",
  "displayName": "Agilebot Counter",
  "description": "Counter extension with shared domain architecture",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],  
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agilebot.viewEngine",
        "title": "Agilebot: View Engine"
      }
    ]
  },
  "scripts": {
    "pre-build": "npm run check-types && npm run copy-static",
    "compile": "npm run pre-build && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run pre-build && node esbuild.js --production",    
    "copy-static": "npx copyfiles -u 1 \"src/**/*.html\" \"src/**/*.css\" \"src/**/*_client.ts\" dist",
    "lint": "eslint src --ext ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "wdio run wdio.conf.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@wdio/cli": "^8.46.0",
    "@wdio/local-runner": "^8.46.0",
    "@wdio/mocha-framework": "^8.46.0",
    "@wdio/spec-reporter": "^8.43.0",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wdio-vscode-service": "^6.1.4",
    "webdriverio": "^8.46.0"
  }
}
